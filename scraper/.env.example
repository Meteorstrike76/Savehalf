# Used only by the scraper (locally or as GitHub Actions secrets). NEVER put these in the frontend / Vercel.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR-SECRET-OR-SERVICE-ROLE-KEY

# Optional tuning (defaults shown)
MAX_PER_STORE=300
MIN_DISCOUNT_PCT=20
MIN_ROWS_TO_EXPIRE=10
